# Copy to .env and fill in. Never commit .env.

# ---- LLM ----
# Required unless LLM_PROVIDER=mock.
ANTHROPIC_API_KEY=
# anthropic | mock   (mock returns canned results so the app can be smoke-tested without a key)
LLM_PROVIDER=anthropic
# Any current Claude model id. claude-sonnet-5-5 is about half the cost of Opus; claude-haiku-5-5 is near-free but weaker.
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Opus 5.5 defaults to medium, so set it explicitly.
LLM_EFFORT=high
LLM_MAX_OUTPUT_TOKENS=16000
# How many of the six category extraction calls run at once.
LLM_CATEGORY_CONCURRENCY=3
# New jobs are refused once the day's estimated spend passes this (USD). Cached and precomputed results still work.
DAILY_USD_CAP=25

# ---- Uploads and jobs ----
MAX_UPLOAD_MB=200
# Documents whose text exceeds this many tokens are rejected instead of truncated.
MAX_DOC_TOKENS=400000
UPLOADS_PER_HOUR_PER_IP=10
JOB_CONCURRENCY=1
JOB_TIMEOUT_MIN=20
# Optional. When set, the header shows a "Source code (zip)" download link pointing here.
SOURCE_ZIP_URL=

# ---- Server ----
NODE_ENV=production
PORT=3000
# Uploads, job records, caches and the budget ledger live here. Mounted as a volume in docker-compose.yml.
DATA_DIR=/data
