{
  "name": "doc-extraction-tool",
  "version": "0.1.0",
  "private": true,
  "description": "DocExtract: LLM-powered extraction of goals, BMPs, implementation, monitoring, outreach and geographic areas from watershed plan PDFs.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter backend --filter frontend dev",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "start": "node backend/dist/server.js",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p eval/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter backend test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "extract-text": "pnpm --filter backend extract-text",
    "eval": "tsx eval/run-eval.ts",
    "eval:fetch": "node eval/fetch.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@det/shared": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
