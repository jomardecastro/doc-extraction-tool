# Copy to ops/deploy.env (gitignored) and fill in for your VPS.
# SSH host alias (from ~/.ssh/config) of the server; the deploy user must be in the docker group.
REMOTE=docextract
# Directory on the server that holds docker-compose.yml, .env and the current-tag marker.
REMOTE_DIR=/home/jomar/docextract
# Public hostname served by nginx on the box.
DOMAIN=docextract.jdecastro.dev
# Loopback port the container publishes on the box (nginx proxies to it).
HOST_PORT=3120
